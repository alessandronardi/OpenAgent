<Window x:Class="OpenAgent.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="OpenAgent"
        Icon="Assets/OpenAgent.ico"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        AllowDrop="True"
        DragEnter="OnWindowDragEnter"
        DragOver="OnWindowDragOver"
        DragLeave="OnWindowDragLeave"
        Drop="OnWindowDrop"
        MouseLeftButtonDown="OnWindowMouseLeftButtonDown">

    <Window.Resources>
        <!-- Soft DropShadow for Fluent floating card -->
        <DropShadowEffect x:Key="CardShadow" BlurRadius="18" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.55"/>
        <DropShadowEffect x:Key="GhostGlow" x:Name="GhostGlowEffect" BlurRadius="14" ShadowDepth="0" Color="#5A78FF" Opacity="0.50"/>

        <!-- Animation for gentle idle floating -->
        <Storyboard x:Key="GhostFloatingAnimation" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="GhostContainer"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                             From="0" To="-6" Duration="0:0:1.8">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <!-- Balloon / Message panel -->
            <RowDefinition Height="Auto"/>
            <!-- Ghost avatar and mini bar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. SPEECH BALLOON / CHAT CARD -->
        <Border x:Name="BalloonBorder"
                Grid.Row="0"
                Margin="0,0,0,10"
                Width="380"
                Background="#1D1E24"
                BorderBrush="#31333E"
                BorderThickness="1"
                CornerRadius="14"
                Effect="{StaticResource CardShadow}"
                Visibility="Visible">
            <Grid Margin="12,10,12,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header: Status indicator, Badges & Control buttons -->
                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#10B981" Margin="0,0,6,0"/>
                        <TextBlock x:Name="StatusBadgeText"
                                   Text="In ascolto"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#9CA3AF"/>
                        <Button x:Name="BtnQuickModelProfile"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="2,0"
                                Cursor="Hand"
                                ToolTip="Clicca per cambiare modello al volo (Desktop &amp; Tools / Web &amp; Reasoning / Generale)"
                                Click="OnQuickModelProfileClicked">
                            <TextBlock x:Name="ModelMetricsText"
                                       Text=" · Modello Locale"
                                       FontSize="11"
                                       Foreground="#60A5FA"/>
                        </Button>

                        <!-- Network Access Indicator Badge -->
                        <Border x:Name="NetworkBadge"
                                Background="#1E3A5F"
                                BorderBrush="#3B82F6"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="4,1"
                                Margin="6,0,0,0"
                                Visibility="Collapsed">
                            <TextBlock x:Name="NetworkBadgeText"
                                       Text="🌐 Rete"
                                       FontSize="10"
                                       Foreground="#93C5FD"/>
                        </Border>

                        <!-- Multi-Step Progress Badge (Sprint 4) -->
                        <Border x:Name="StepBadge"
                                Background="#2E1B4E"
                                BorderBrush="#A855F7"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="5,1"
                                Margin="6,0,0,0"
                                Visibility="Collapsed">
                            <TextBlock x:Name="StepBadgeText"
                                       Text="Passo 1/4"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="#E9D5FF"/>
                        </Border>
                    </StackPanel>

                    <!-- Settings, Click-through lock and Close/Hide buttons -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="BtnOpenSettings"
                                Click="OnOpenSettingsClicked"
                                ToolTip="Impostazioni OpenAgent (Modello, Allowlist, Memoria)"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Padding="4,2"
                                Margin="0,0,4,0">
                            <TextBlock Text="⚙️" FontSize="11" Foreground="#9CA3AF"/>
                        </Button>
                        <Button x:Name="BtnClickThroughToggle"
                                Click="OnClickThroughToggleClicked"
                                ToolTip="Attiva/Disattiva Click-Through (i click passano sotto)"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Padding="4,2"
                                Margin="0,0,4,0">
                            <TextBlock x:Name="ClickThroughIconText" Text="🔓" FontSize="11" Foreground="#9CA3AF"/>
                        </Button>
                        <Button Click="OnHideBalloonClicked"
                                ToolTip="Riduci a icona"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Padding="4,2">
                            <TextBlock Text="✕" FontSize="11" Foreground="#9CA3AF"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Speech Bubble Text / Response Area -->
                <ScrollViewer Grid.Row="1"
                              MaxHeight="180"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Margin="0,2,0,8">
                    <TextBlock x:Name="SpeechText"
                               Text="Ciao! Sono OpenAgent. Come posso aiutarti con i tuoi file o sul web oggi?"
                               Foreground="#F3F4F6"
                               FontSize="13"
                               TextWrapping="Wrap"
                               LineHeight="18"/>
                </ScrollViewer>

                <!-- Tool Confirmation Panel (Row 2) -->
                <Border x:Name="ConfirmationPanel"
                        Grid.Row="2"
                        Background="#261E16"
                        BorderBrush="#EAB308"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10,8"
                        Margin="0,0,0,8"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0">
                            <TextBlock x:Name="ConfirmationBadgeText"
                                       Text="⚠️ CONFERMA OPERAZIONE"
                                       FontWeight="Bold"
                                       FontSize="11"
                                       Foreground="#FDE047"
                                       Margin="0,0,0,4"/>
                            <TextBlock x:Name="ConfirmationPromptText"
                                       Text="Richiesta autorizzazione per operazione su file."
                                       FontSize="11"
                                       Foreground="#F3F4F6"
                                       TextWrapping="Wrap"
                                       LineHeight="15"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                            <Button x:Name="BtnConfirmReject"
                                    Click="OnConfirmRejectClicked"
                                    Content="Rifiuta"
                                    FontSize="11"
                                    Foreground="#D1D5DB"
                                    Background="#374151"
                                    BorderThickness="0"
                                    Padding="10,3"
                                    Margin="0,0,6,0"
                                    Cursor="Hand"/>
                            <Button x:Name="BtnConfirmAccept"
                                    Click="OnConfirmAcceptClicked"
                                    Content="Autorizza"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="#FFFFFF"
                                    Background="#EAB308"
                                    BorderThickness="0"
                                    Padding="12,3"
                                    Cursor="Hand"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Mini Prompt Input Bar (Row 3) -->
                <Border Grid.Row="3"
                        Background="#121316"
                        BorderBrush="#2B2D38"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="4,2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="PromptInput"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="#F9FAFB"
                                 CaretBrush="#60A5FA"
                                 FontSize="12"
                                 VerticalContentAlignment="Center"
                                 Padding="6,4"
                                 KeyDown="OnPromptInputKeyDown"/>

                        <TextBlock x:Name="PromptPlaceholder"
                                   Text="Chiedi qualcosa o trascina un file..."
                                   Foreground="#6B7280"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,0"
                                   IsHitTestVisible="False"/>

                        <!-- Action buttons: Cancel (active during task) & Send -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BtnCancelExecution"
                                    Click="OnCancelExecutionClicked"
                                    ToolTip="Interrompi operazione in corso (Esc)"
                                    Background="#DC2626"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Width="26"
                                    Height="26"
                                    Margin="2,2,4,2"
                                    Visibility="Collapsed">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                                <TextBlock Text="⏹" FontSize="11" FontWeight="Bold" Margin="0,-1,0,0"/>
                            </Button>

                            <Button x:Name="BtnVoiceInput"
                                    Click="OnVoiceInputClicked"
                                    ToolTip="Parla con l'avatar (Ctrl+Shift+V)"
                                    Background="#1E293B"
                                    Foreground="#38BDF8"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Width="28"
                                    Height="26"
                                    Margin="2"
                                    VerticalAlignment="Center">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                                <TextBlock x:Name="VoiceButtonIcon" Text="🎙️" FontSize="12" Margin="0,-1,0,0"/>
                            </Button>

                            <Button x:Name="BtnSendPrompt"
                                    Click="OnSendPromptClicked"
                                    Background="#3B82F6"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Width="28"
                                    Height="26"
                                    Margin="2"
                                    VerticalAlignment="Center"
                                    ToolTip="Invia richiesta (Invio)">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                                <TextBlock Text="➔" FontSize="12" FontWeight="Bold" Margin="0,-1,0,0"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Drag & Drop visual target overlay (Sprint 4) -->
                <Border x:Name="DropZoneOverlay"
                        Grid.Row="0"
                        Grid.RowSpan="4"
                        Background="#201C35"
                        BorderBrush="#8B5CF6"
                        BorderThickness="2"
                        CornerRadius="12"
                        Padding="14"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Visibility="Collapsed"
                        IsHitTestVisible="False">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="📂" FontSize="26" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                        <TextBlock Text="Rilascia qui file o cartelle"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#E9D5FF"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="OpenAgent preparerà l'analisi automatica"
                                   FontSize="10"
                                   Foreground="#C4B5FD"
                                   HorizontalAlignment="Center"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 2. PIXEL-ART GHOST CHARACTER -->
        <Grid x:Name="GhostRowGrid"
              Grid.Row="1"
              HorizontalAlignment="Right"
              Margin="0,0,16,0"
              Cursor="Hand">

            <Grid x:Name="GhostContainer"
                  Effect="{StaticResource GhostGlow}"
                  MouseLeftButtonDown="OnGhostMouseLeftButtonDown"
                  MouseMove="OnGhostMouseMove"
                  MouseLeftButtonUp="OnGhostMouseLeftButtonUp"
                  ToolTip="Clicca per mostrare/nascondere la finestra di chat. Trascina per spostarmi!">
                <Grid.RenderTransform>
                    <TranslateTransform Y="0"/>
                </Grid.RenderTransform>

                <!-- Retro Pixel-Art Octopus (Vector Grid 24x24 with dynamic outfits) -->
                <Viewbox Width="72" Height="72" Stretch="Uniform" SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="NearestNeighbor">
                    <Canvas Width="24" Height="24" x:Name="GhostCanvas">
                        <!-- Octopus Mantle (Head Dome) -->
                        <Rectangle Canvas.Left="9" Canvas.Top="4" Width="6" Height="1" Fill="#0EA5E9" x:Name="OctoDome1"/>
                        <Rectangle Canvas.Left="7" Canvas.Top="5" Width="10" Height="1" Fill="#0EA5E9" x:Name="OctoDome2"/>
                        <Rectangle Canvas.Left="6" Canvas.Top="6" Width="12" Height="2" Fill="#0EA5E9" x:Name="OctoDome3"/>
                        <Rectangle Canvas.Left="5" Canvas.Top="8" Width="14" Height="6" Fill="#0EA5E9" x:Name="OctoBodyMain"/>
                        <Rectangle Canvas.Left="6" Canvas.Top="14" Width="12" Height="1" Fill="#0EA5E9" x:Name="OctoDomeBase"/>

                        <!-- Mantle Highlights & Shading (Retro Pixel Depth) -->
                        <Rectangle Canvas.Left="8" Canvas.Top="5" Width="3" Height="1" Fill="#38BDF8" x:Name="OctoHighlight1"/>
                        <Rectangle Canvas.Left="6" Canvas.Top="6" Width="2" Height="1" Fill="#38BDF8" x:Name="OctoHighlight2"/>
                        <Rectangle Canvas.Left="15" Canvas.Top="6" Width="2" Height="1" Fill="#0284C7" x:Name="OctoShadow1"/>
                        <Rectangle Canvas.Left="16" Canvas.Top="8" Width="1" Height="2" Fill="#0284C7" x:Name="OctoShadow2"/>

                        <!-- Eyebrows / Brow Line -->
                        <Rectangle Canvas.Left="6" Canvas.Top="9" Width="4" Height="1" Fill="#0284C7" x:Name="OctoBrowLeft"/>
                        <Rectangle Canvas.Left="14" Canvas.Top="9" Width="4" Height="1" Fill="#0284C7" x:Name="OctoBrowRight"/>

                        <!-- Sclera (White eye background) -->
                        <Rectangle Canvas.Left="7" Canvas.Top="10" Width="3" Height="3" Fill="#F8FAFC" x:Name="OctoLeftSclera"/>
                        <Rectangle Canvas.Left="14" Canvas.Top="10" Width="3" Height="3" Fill="#F8FAFC" x:Name="OctoRightSclera"/>

                        <!-- Eyes / Pupils (x:Name retained for animations) -->
                        <Rectangle Canvas.Left="8" Canvas.Top="11" Width="2" Height="2" Fill="#0F172A" x:Name="GhostLeftEye"/>
                        <Rectangle Canvas.Left="14" Canvas.Top="11" Width="2" Height="2" Fill="#0F172A" x:Name="GhostRightEye"/>

                        <!-- Eye twinkle / Iris accent -->
                        <Rectangle Canvas.Left="7" Canvas.Top="10" Width="1" Height="1" Fill="#38BDF8" x:Name="GhostLeftTwinkle"/>
                        <Rectangle Canvas.Left="16" Canvas.Top="10" Width="1" Height="1" Fill="#38BDF8" x:Name="GhostRightTwinkle"/>

                        <!-- Cheeks (Hidden for non-kawaii arcade aesthetic) -->
                        <Rectangle Canvas.Left="6" Canvas.Top="13" Width="2" Height="1" Fill="#FDA4AF" x:Name="GhostLeftBlush" Visibility="Collapsed"/>
                        <Rectangle Canvas.Left="16" Canvas.Top="13" Width="2" Height="1" Fill="#FDA4AF" x:Name="GhostRightBlush" Visibility="Collapsed"/>

                        <!-- Central Siphon / Beak base & mouth -->
                        <Rectangle Canvas.Left="11" Canvas.Top="13" Width="2" Height="2" Fill="#0284C7" x:Name="OctoSiphon"/>
                        <Rectangle Canvas.Left="11" Canvas.Top="14" Width="2" Height="1" Fill="#0369A1" x:Name="OctoSiphonShadow"/>
                        <Rectangle Canvas.Left="11" Canvas.Top="13" Width="2" Height="1" Fill="#0F172A" x:Name="GhostMouth" Visibility="Collapsed"/>

                        <!-- 8 Articulated Pixel Tentacles with Suction Cups -->
                        <!-- Tentacle 1: Outer Left -->
                        <Rectangle Canvas.Left="4" Canvas.Top="15" Width="2" Height="2" Fill="#0EA5E9" x:Name="OctoT1A"/>
                        <Rectangle Canvas.Left="3" Canvas.Top="16" Width="2" Height="2" Fill="#0EA5E9" x:Name="OctoT1B"/>
                        <Rectangle Canvas.Left="2" Canvas.Top="17" Width="1" Height="1" Fill="#0284C7" x:Name="OctoT1Tip"/>
                        <Rectangle Canvas.Left="4" Canvas.Top="17" Width="1" Height="1" Fill="#BAE6FD" x:Name="OctoS1"/>

                        <!-- Tentacle 2: Outer-Mid Left -->
                        <Rectangle Canvas.Left="6" Canvas.Top="15" Width="2" Height="3" Fill="#0EA5E9" x:Name="OctoT2A"/>
                        <Rectangle Canvas.Left="5" Canvas.Top="18" Width="2" Height="1" Fill="#0284C7" x:Name="OctoT2Tip"/>
                        <Rectangle Canvas.Left="7" Canvas.Top="16" Width="1" Height="1" Fill="#BAE6FD" x:Name="OctoS2"/>

                        <!-- Tentacle 3: Inner-Mid Left -->
                        <Rectangle Canvas.Left="8" Canvas.Top="15" Width="2" Height="4" Fill="#0EA5E9" x:Name="OctoT3A"/>
                        <Rectangle Canvas.Left="7" Canvas.Top="19" Width="2" Height="1" Fill="#0369A1" x:Name="OctoT3Tip"/>
                        <Rectangle Canvas.Left="9" Canvas.Top="17" Width="1" Height="1" Fill="#BAE6FD" x:Name="OctoS3"/>

                        <!-- Tentacle 4: Center Left (front) -->
                        <Rectangle Canvas.Left="10" Canvas.Top="15" Width="2" Height="4" Fill="#0284C7" x:Name="OctoT4A"/>
                        <Rectangle Canvas.Left="10" Canvas.Top="19" Width="2" Height="1" Fill="#0369A1" x:Name="OctoT4Tip"/>
                        <Rectangle Canvas.Left="10" Canvas.Top="16" Width="1" Height="1" Fill="#BAE6FD" x:Name="OctoS4A"/>
                        <Rectangle Canvas.Left="11" Canvas.Top="18" Width="1" Height="1" Fill="#BAE6FD" x:Name="OctoS4B"/>

                        <!-- Tentacle 5: Center Right (front) -->
                        <Rectangle Canvas.Left="12" Canvas.Top="15" Width="2" Height="4" Fill="#0284C7" x:Name="OctoT5A"/>
                        <Rectangle Canvas.Left="12" Canvas.Top="19" Width="2" Height="1" Fill="#0369A1" x:Name="OctoT5Tip"/>
                        <Rectangle Canvas.Left="13" Canvas.Top="16" Width="1" Height="1" Fill="#BAE6FD" x:Name="OctoS5A"/>
                        <Rectangle Canvas.Left="12" Canvas.Top="18" Width="1" Height="1" Fill="#BAE6FD" x:Name="OctoS5B"/>

                        <!-- Tentacle 6: Inner-Mid Right -->
                        <Rectangle Canvas.Left="14" Canvas.Top="15" Width="2" Height="4" Fill="#0EA5E9" x:Name="OctoT6A"/>
                        <Rectangle Canvas.Left="15" Canvas.Top="19" Width="2" Height="1" Fill="#0369A1" x:Name="OctoT6Tip"/>
                        <Rectangle Canvas.Left="14" Canvas.Top="17" Width="1" Height="1" Fill="#BAE6FD" x:Name="OctoS6"/>

                        <!-- Tentacle 7: Outer-Mid Right -->
                        <Rectangle Canvas.Left="16" Canvas.Top="15" Width="2" Height="3" Fill="#0EA5E9" x:Name="OctoT7A"/>
                        <Rectangle Canvas.Left="17" Canvas.Top="18" Width="2" Height="1" Fill="#0284C7" x:Name="OctoT7Tip"/>
                        <Rectangle Canvas.Left="16" Canvas.Top="16" Width="1" Height="1" Fill="#BAE6FD" x:Name="OctoS7"/>

                        <!-- Tentacle 8: Outer Right -->
                        <Rectangle Canvas.Left="18" Canvas.Top="15" Width="2" Height="2" Fill="#0EA5E9" x:Name="OctoT8A"/>
                        <Rectangle Canvas.Left="19" Canvas.Top="16" Width="2" Height="2" Fill="#0EA5E9" x:Name="OctoT8B"/>
                        <Rectangle Canvas.Left="21" Canvas.Top="17" Width="1" Height="1" Fill="#0284C7" x:Name="OctoT8Tip"/>
                        <Rectangle Canvas.Left="19" Canvas.Top="17" Width="1" Height="1" Fill="#BAE6FD" x:Name="OctoS8"/>

                        <!-- 1. The Grimoire / Wizard (search_web) -->
                        <Canvas x:Name="LayerGrimoire" Width="24" Height="24" Visibility="Collapsed">
                            <!-- Wizard Hat -->
                            <Rectangle Canvas.Left="5" Canvas.Top="6" Width="14" Height="1" Fill="#4338CA"/>
                            <Rectangle Canvas.Left="7" Canvas.Top="5" Width="10" Height="1" Fill="#4F46E5"/>
                            <Rectangle Canvas.Left="8" Canvas.Top="4" Width="8" Height="1" Fill="#4F46E5"/>
                            <Rectangle Canvas.Left="9" Canvas.Top="3" Width="6" Height="1" Fill="#4F46E5"/>
                            <Rectangle Canvas.Left="10" Canvas.Top="2" Width="4" Height="1" Fill="#6366F1"/>
                            <Rectangle Canvas.Left="12" Canvas.Top="1" Width="3" Height="1" Fill="#6366F1"/>
                            <Rectangle Canvas.Left="7" Canvas.Top="5" Width="10" Height="1" Fill="#F59E0B"/>
                            <Rectangle Canvas.Left="11" Canvas.Top="4" Width="2" Height="1" Fill="#FDE047"/>

                            <!-- Grimoire Spellbook -->
                            <Rectangle Canvas.Left="5" Canvas.Top="18" Width="14" Height="5" Fill="#312E81"/>
                            <Rectangle Canvas.Left="11" Canvas.Top="18" Width="2" Height="5" Fill="#1E1B4B"/>
                            <!-- Left open page -->
                            <Rectangle Canvas.Left="6" Canvas.Top="18" Width="5" Height="4" Fill="#F5F3FF"/>
                            <Rectangle Canvas.Left="7" Canvas.Top="19" Width="3" Height="1" Fill="#818CF8"/>
                            <Rectangle Canvas.Left="7" Canvas.Top="20" Width="3" Height="1" Fill="#A5B4FC"/>
                            <!-- Right open page -->
                            <Rectangle Canvas.Left="13" Canvas.Top="18" Width="5" Height="4" Fill="#F5F3FF"/>
                            <Rectangle Canvas.Left="14" Canvas.Top="19" Width="3" Height="1" Fill="#818CF8"/>
                            <Rectangle Canvas.Left="14" Canvas.Top="20" Width="3" Height="1" Fill="#A5B4FC"/>
                            <!-- Flipping page frames -->
                            <Rectangle Canvas.Left="10" Canvas.Top="17" Width="2" Height="4" Fill="#DDD6FE" x:Name="GrimoireFlipA" Visibility="Visible"/>
                            <Rectangle Canvas.Left="12" Canvas.Top="17" Width="2" Height="4" Fill="#DDD6FE" x:Name="GrimoireFlipB" Visibility="Collapsed"/>
                            <!-- Mystical Sparkles -->
                            <Rectangle Canvas.Left="4" Canvas.Top="16" Width="1" Height="1" Fill="#FDE047" x:Name="GrimoireSparkle1"/>
                            <Rectangle Canvas.Left="19" Canvas.Top="15" Width="1" Height="1" Fill="#38BDF8" x:Name="GrimoireSparkle2"/>
                            <Rectangle Canvas.Left="12" Canvas.Top="15" Width="1" Height="1" Fill="#C084FC" x:Name="GrimoireSparkle3"/>
                        </Canvas>

                        <!-- 2. Crystal Scrying Orb / Web Browsing (fetch_url_text) -->
                        <Canvas x:Name="LayerScryingOrb" Width="24" Height="24" Visibility="Collapsed">
                            <!-- Cyber Monocle / Visor -->
                            <Rectangle Canvas.Left="13" Canvas.Top="10" Width="4" Height="4" Stroke="#06B6D4" StrokeThickness="1" Fill="Transparent"/>
                            <Rectangle Canvas.Left="14" Canvas.Top="11" Width="2" Height="2" Fill="#22D3EE" Opacity="0.4"/>
                            <Rectangle Canvas.Left="17" Canvas.Top="9" Width="2" Height="1" Fill="#06B6D4"/>
                            <!-- Scrying Orb Stand -->
                            <Rectangle Canvas.Left="9" Canvas.Top="21" Width="6" Height="2" Fill="#334155"/>
                            <!-- Crystal Orb -->
                            <Rectangle Canvas.Left="9" Canvas.Top="16" Width="6" Height="5" Fill="#0284C7" Opacity="0.85"/>
                            <Rectangle Canvas.Left="10" Canvas.Top="17" Width="4" Height="3" Fill="#38BDF8" x:Name="ScryingSwirl"/>
                            <Rectangle Canvas.Left="11" Canvas.Top="18" Width="2" Height="1" Fill="#FFFFFF"/>
                            <Rectangle Canvas.Left="10" Canvas.Top="16" Width="1" Height="1" Fill="#FFFFFF"/>
